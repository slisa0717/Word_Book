<!--<p style="color: green"><%= notice %></p>
-->
<h1 class="words-title">
  Words
</h1>
<hr>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>English</th>
        <th>japanese</th>
        <th> action</th>
      </tr>

    </thead>
    <tbody>
      <% @words.each do |word| %>
        <tr>
          <td><%= word.id %></td>
          <td><%= word.english %></td>
          <td><%= word.japanese %></td>
          <td>
            <%= link_to 'Edit', edit_word_path(word) %>
            <%= button_to "Destroy this word", word, method: :delete %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% @words.each do |word| %>
    <%#= render word %>
    <%= "#{word.id}" %><br>
  <% end %>
<hr>
<div id="words">
  <% @words.each do |word| %>
    <%#= render word %>
    <p>
      <%= link_to "Show this word", word %>
    </p>
  <% end %>
</div>

<%= link_to "New word", new_word_path %>